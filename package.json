{
  "name": "ai-roundtable",
  "version": "0.4.0",
  "description": "Local multi-agent roundtable powered by Pi",
  "type": "module",
  "main": "desktop/main.mjs",
  "license": "MIT",
  "author": "AI Roundtable contributors",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "desktop": "electron .",
    "check": "node --check server.mjs && node --check src/store.mjs && node --check src/engine.mjs && node --check src/pi-session.mjs && node --check public/app.js && node --check desktop/data.mjs && node --check desktop/main.mjs",
    "package:win": "npm run check && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@sinclair/typebox": "0.34.41"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.3"
    },
    "openai": {
      "undici": "8.12.3"
    }
  },
  "build": {
    "appId": "local.airoundtable.desktop",
    "productName": "AI Roundtable",
    "electronVersion": "44.10.0",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "src/**/*",
      "server.mjs",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "artifactName": "AI-Roundtable-${version}-win-${arch}.${ext}"
  }
}
